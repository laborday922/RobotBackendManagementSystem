<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.qa.ChatLog.mapper.QaLogMapper">

    <resultMap type="QaLog" id="QaLogResult">
        <result property="id" column="id"/>
        <result property="robotId" column="robot_id"/>
        <result property="chatId" column="chat_id"/>
        <result property="conversationId" column="conversation_id"/>
        <result property="query" column="query"/>
        <result property="answer" column="answer"/>
        <result property="status" column="status"/>
        <result property="errorMessage" column="error_message"/>
        <result property="durationMs" column="duration_ms"/>
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectQaLogVo">
        select id, robot_id, chat_id, conversation_id, query, answer, status, error_message, duration_ms, create_time
        from qa_log
    </sql>

    <select id="selectQaLogById" parameterType="Long" resultMap="QaLogResult">
        <include refid="selectQaLogVo"/>
        where id = #{id}
    </select>

    <insert id="insertQaLog" parameterType="QaLog" useGeneratedKeys="true" keyProperty="id">
        insert into qa_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="robotId != null">robot_id,</if>
            <if test="chatId != null">chat_id,</if>
            <if test="conversationId != null and conversationId != ''">conversation_id,</if>
            <if test="query != null">query,</if>
            <if test="answer != null">answer,</if>
            <if test="status != null">status,</if>
            <if test="errorMessage != null and errorMessage != ''">error_message,</if>
            <if test="durationMs != null">duration_ms,</if>
            <if test="createTime != null">create_time,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="robotId != null">#{robotId},</if>
            <if test="chatId != null">#{chatId},</if>
            <if test="conversationId != null and conversationId != ''">#{conversationId},</if>
            <if test="query != null">#{query},</if>
            <if test="answer != null">#{answer},</if>
            <if test="status != null">#{status},</if>
            <if test="errorMessage != null and errorMessage != ''">#{errorMessage},</if>
            <if test="durationMs != null">#{durationMs},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

</mapper>
