<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ruoyi.data.clean.mapper.CleanExecuteHistoryMapper">

    <resultMap id="BaseResultMap" type="com.ruoyi.data.clean.domain.CleanExecuteHistory">
        <id property="id" column="id"/>
        <result property="executeMode" column="execute_mode"/>
        <result property="applyDataSource" column="apply_data_source"/>
        <result property="runTime" column="run_time"/>
        <result property="configJson" column="config_json"/>
        <result property="createTime" column="create_time"/>
        <result property="cronExpression" column="cron_expression"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO clean_rule_config
        (execute_mode, apply_data_source, run_time,
         config_json, create_time, cron_expression)
        VALUES
            (#{executeMode}, #{applyDataSource}, #{runTime},
             #{configJson}, #{createTime}, #{cronExpression})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT * FROM clean_rule_config
        WHERE id = #{id}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT * FROM clean_rule_config
        WHERE execute_mode = 'SCHEDULED'
        ORDER BY create_time DESC
    </select>

    <update id="update">
        UPDATE clean_rule_config
        SET execute_mode = #{executeMode},
            apply_data_source = #{applyDataSource},
            config_json = #{configJson},
            cron_expression = #{cronExpression}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM clean_rule_config
        WHERE id = #{id}
    </delete>

</mapper>
